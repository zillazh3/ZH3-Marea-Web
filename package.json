{
  "name": "zh3marea",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zillazh3/ZH3-Marea-Web.git"
  },
  "homepage": "https://github.com/zillazh3/ZH3-Marea-Web#readme",
  "bugs": {
    "url": "https://github.com/zillazh3/ZH3-Marea-Web/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:static": "npm run build && playwright test -c playwright.static.config.ts",
    "preview:static": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "smoke": "node tools/smoke.mjs",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "dependencies": {
    "canvaskit-wasm": "^0.42.0",
    "idb": "^8.0.4",
    "mediabunny": "^1.66.0",
    "svelte": "5.57.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "^4.163.0"
  }
}
